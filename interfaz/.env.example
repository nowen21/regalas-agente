# Las variables del visor, sin valores. Se copia a .env (que no se versiona)
# y se llenan las que hagan falta; las demás pueden quedar vacías.

# Llave de Django. Solo obligatoria si el visor se despliega fuera de la
# máquina local (en local, local.py trae una de desarrollo).
SECRET_KEY=

# Ruta a otra base de memoria, si no se quiere la del estándar (senales.db).
MEMORIA_DB=
