# Copiar a `.env` y llenar. El archivo `.env` NO se versiona.
# La plataforma no necesita credenciales para funcionar: la base es un archivo local.

# El puerto donde levanta `python manage.py runserver` cuando no se le dice otro.
# Vive acá y no en el código porque es de esta máquina: en otra puede estar tomado.
PUERTO=8000

# Esta clave solo firma las sesiones del navegador en esta máquina.
CLAVE_DE_FIRMA=
