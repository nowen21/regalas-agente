# Copiar a `.env` y llenar. El archivo `.env` NO se versiona.

# El puerto donde levanta `python manage.py runserver` cuando no se le dice otro.
PUERTO=8000

# Firma las sesiones del navegador en esta máquina.
CLAVE_DE_FIRMA=

# La conexión a MariaDB. `python manage.py preparar_base` crea la base si falta.
DB_NOMBRE=
DB_USUARIO=
DB_CLAVE=
DB_SERVIDOR=
DB_PUERTO=
